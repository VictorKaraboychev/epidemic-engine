{
    "name": "epidemic-engine",
    "version": "0.2.0",
    "private": true,
    "description": "Stochastic epidemics on contact networks of up to a million people, with a deterministic reference and pathogens set from published estimates (every value cited).",
    "keywords": [
        "epidemic",
        "epidemiology",
        "SEIR",
        "SIR",
        "stochastic",
        "network",
        "simulation",
        "infectious disease"
    ],
    "homepage": "https://github.com/VictorKaraboychev/epidemic-engine#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/VictorKaraboychev/epidemic-engine.git"
    },
    "bugs": {
        "url": "https://github.com/VictorKaraboychev/epidemic-engine/issues"
    },
    "license": "MIT",
    "author": "Victor Karaboychev",
    "contributors": [
        "Ziyuan Zhang"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./advanced": {
            "types": "./dist/advanced.d.ts",
            "default": "./dist/advanced.js"
        },
        "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src",
        "!src/**/*.test.ts",
        "!src/validation",
        "!src/test-support.ts",
        "README.md",
        "LICENSE",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json",
        "test": "vitest run",
        "validate": "VALIDATE=1 vitest run src/validation",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "npm run build",
        "version": "node scripts/sync-version.mjs && git add src/version.ts",
        "api": "api-extractor run --local -c api-extractor.json && api-extractor run --local -c api-extractor.advanced.json",
        "check:api": "api-extractor run -c api-extractor.json && api-extractor run -c api-extractor.advanced.json",
        "check:package": "publint && attw --pack . --profile esm-only",
        "check:browser": "node scripts/check-browser.mjs",
        "check:consumer": "node scripts/check-consumer.mjs",
        "benchmark": "node scripts/benchmark.mjs"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@microsoft/api-extractor": "^7.60.1",
        "@types/node": "^26.6.3",
        "esbuild": "^0.28.2",
        "prettier": "^3.10.1",
        "publint": "^0.3.25",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    },
    "dependencies": {
        "pure-rand": "^8.4.2"
    }
}
